TELEGRAM_BOT_TOKEN=...
# NEAR_ACCOUNT_ID must be the vault's parent — the account holding the access
# key the bot signs with. View_access_key(NEAR_ACCOUNT_ID, pubkey) is the
# coordinator-side auth gate.
NEAR_ACCOUNT_ID=my-tipbot.near
NEAR_PRIVATE_KEY=ed25519:...
# Optional. Full vault account id, returned by `outlayer vault init` or the
# dashboard vault page. If set, the vault's parent on-chain MUST equal
# NEAR_ACCOUNT_ID, and wallets derive under the vault's MPC master (sovereign
# exit). Leave unset to use the base (account_id, seed) derivation.
# NOTE: adding/removing this re-derives every user's address — set once.
OUTLAYER_VAULT_ID=vault.my-tipbot.near
OUTLAYER_API=https://api.outlayer.fastnear.com
WNEAR_TOKEN=wrap.near
USDC_TOKEN=17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1
DEPOSIT_CONTRACT=deposit.tipbot.near
RUST_LOG=outlayer_tipbot=debug

# Dice game — an optional, feature-gated demo: real-money dice betting in
# Telegram group chats. Players stake NEAR/USDC (locked via Outlayer payment
# checks), highest roll wins the pot. Build it in with `cargo run --features dice`
# (off by default — the core bot is stateless; dice keeps an on-disk game journal).
# Only runs in chats listed in DICE_ALLOWED_CHATS. These vars are ignored unless
# the `dice` feature is enabled. Set DICE_DEMO=true to play with no real funds.
DICE_ALLOWED_CHATS=-100123456789,-100987654321
DICE_BETTING_TIMEOUT=120
DICE_ROLLING_TIMEOUT=120
DICE_MIN_NEAR=0.1
DICE_MAX_NEAR=10
DICE_MIN_USDC=0.1
DICE_MAX_USDC=10
DICE_FEE=0
DICE_FEE_ACCOUNT=0
DICE_DEMO=false
