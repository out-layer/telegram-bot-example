TELEGRAM_BOT_TOKEN=...
# NEAR_ACCOUNT_ID must be the vault's parent — the account holding the access
# key the bot signs with. View_access_key(NEAR_ACCOUNT_ID, pubkey) is the
# coordinator-side auth gate.
NEAR_ACCOUNT_ID=my-tipbot.near
NEAR_PRIVATE_KEY=ed25519:...
# Full vault account id, returned by `outlayer vault init` or the dashboard
# vault page. The vault's parent on-chain MUST equal NEAR_ACCOUNT_ID.
OUTLAYER_VAULT_ID=vault.my-tipbot.near
OUTLAYER_API=https://api.outlayer.fastnear.com
WNEAR_TOKEN=wrap.near
USDC_TOKEN=17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1
DEPOSIT_CONTRACT=deposit.tipbot.near
RUST_LOG=outlayer_tipbot=debug

# Dice game
DICE_ALLOWED_CHATS=-100123456789,-100987654321
DICE_BETTING_TIMEOUT=120
DICE_ROLLING_TIMEOUT=120
DICE_MIN_NEAR=0.1
DICE_MAX_NEAR=10
DICE_MIN_USDC=0.1
DICE_MAX_USDC=10
DICE_FEE=0
DICE_FEE_ACCOUNT=0
DICE_DEMO=false
